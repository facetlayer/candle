{
  "services": [
    {
      "name": "crasher",
      "shell": "node ../../sampleServers/delayedExitServer.js 3 1000"
    },
    {
      "name": "clean-exit",
      "shell": "node ../../sampleServers/delayedExitServer.js 0 1000"
    },
    {
      "name": "idle",
      "shell": "node ../../sampleServers/testProcess.js"
    },
    {
      "name": "rooted",
      "shell": "node ../../../sampleServers/testProcess.js",
      "root": "sub"
    },
    {
      "name": "missing-root",
      "shell": "node ../../sampleServers/testProcess.js",
      "root": "does-not-exist"
    },
    {
      "name": "self-signal",
      "shell": "kill -9 $$"
    },
    {
      "name": "start-exit",
      "shell": "exit 4"
    },
    {
      "name": "killed-early",
      "shell": "node ../../sampleServers/testProcess.js"
    }
  ]
}
