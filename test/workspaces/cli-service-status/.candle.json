{
  "services": [
    {
      "name": "crasher",
      "shell": "node ../../sampleServers/delayedExitServer.js 3 1000"
    },
    {
      "name": "clean-exit",
      "shell": "node ../../sampleServers/delayedExitServer.js 0 1000"
    },
    {
      "name": "idle",
      "shell": "node ../../sampleServers/testProcess.js"
    },
    {
      "name": "rooted",
      "shell": "node ../../../sampleServers/testProcess.js",
      "root": "sub"
    },
    {
      "name": "missing-root",
      "shell": "node ../../sampleServers/testProcess.js",
      "root": "does-not-exist"
    },
    {
      "name": "self-signal",
      "shell": "kill -9 $$"
    },
    {
      "name": "start-exit",
      "shell": "exit 4"
    },
    {
      "name": "killed-early",
      "shell": "node ../../sampleServers/testProcess.js"
    },
    {
      "name": "signal-crash",
      "shell": "sleep 1; kill -SEGV $$"
    },
    {
      "name": "binary-output",
      "shell": "printf 'bad \\377 byte\\n'; while true; do echo tick; sleep 0.2; done"
    }
  ]
}
